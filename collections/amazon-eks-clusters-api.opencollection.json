            "url": "https://eks.amazonaws.com/clusters/:name",
            "params": [
              {
                "name": "name",
                "value": "example-resource-name",
                "type": "path"
              }
            ]
          },
          "docs": "Returns descriptive information about an Amazon EKS cluster."
        },
        {
          "info": {
            "name": "Amazon EKS Delete an EKS Cluster",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
